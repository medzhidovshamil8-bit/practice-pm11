  {
    "query": "Q15. Классификация оплаты через CASE",
    "sql": "WITH paid AS (SELECT booking_id,SUM(amount_kopecks) AS amount FROM payment GROUP BY booking_id) SELECT b.booking_id,CASE WHEN COALESCE(p.amount,0)=0 THEN 'Не оплачено' WHEN p.amount<b.total_kopecks THEN 'Частично' WHEN p.amount=b.total_kopecks THEN 'Оплачено' ELSE 'Переплата' END AS payment_state FROM booking b LEFT JOIN paid p USING(booking_id) WHERE b.status<>'cancelled' ORDER BY b.booking_id",
